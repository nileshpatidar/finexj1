# ==============================================================================
# FINEXJ ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT REAL SECRETS OR PRODUCTION VALUES TO THIS FILE.
# ==============================================================================

# Backend Required Production Environment Variables
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# Optional Direct PostgreSQL Pooling (if not using Supabase REST API)
DATABASE_URL=
SUPABASE_DB_URL=
SQL_HOST=
SQL_PORT=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=

# Logging & Diagnostic Flags
NODE_ENV=development
ENABLE_LOGGING=false
ENABLE_DB_LOGGING=false
ENABLE_DEBUG_LOGS=false

# BNB Smart Chain (BSC) Real Blockchain Verification
BSC_RPC_URL=
BSC_FALLBACK_RPC_URLS=
BSC_CHAIN_ID=56
BSC_USDT_CONTRACT_ADDRESS=
BSC_DEPOSIT_WALLET_ADDRESS=
BSC_REQUIRED_CONFIRMATIONS=12

# Optional Frontend Direct Access (Only if client-side direct Supabase is enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
